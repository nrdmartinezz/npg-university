---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/ui/Prose.astro';
import {
  formatPrice,
  getPublished,
  relatedCourses,
  trackById,
  type CourseEntry,
} from '../../lib/courses';

export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await getPublished();
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course, courses },
  }));
};

interface Props {
  course: CourseEntry;
  courses: CourseEntry[];
}

const { course, courses } = Astro.props;
const { Content } = await render(course);
const suggestions = relatedCourses(courses, course);
const trackNames = course.data.tracks.map((id) => trackById(id)?.label).filter(Boolean);
---

<BaseLayout
  title={course.data.title}
  description={course.data.description}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'On-Demand Courses', href: '/courses/' },
    { name: course.data.title, href: `/courses/${course.id}/` },
  ]}
>
  <section class="bg-[#eff4ff] px-6 py-14">
    <div class="mx-auto flex w-full max-w-[860px] flex-col gap-4">
      <p class="font-display text-[11px] leading-[14px] font-bold tracking-[1.1px] text-[#006194] uppercase">
        {trackNames.join(' · ')}
      </p>
      <h1 class="font-display text-[clamp(2rem,4vw,3rem)] leading-[1.15] font-bold tracking-[-0.8px] text-[#0f172a]">
        {course.data.title}
      </h1>
      {course.data.subtitle && <p class="text-xl leading-8 text-[#0f172a]">{course.data.subtitle}</p>}
      <p class="text-lg leading-7 text-[#64748b]">{course.data.description}</p>
      {course.data.instructor && (
        <p class="text-sm leading-5 font-semibold text-[#006194]">{course.data.instructor}</p>
      )}
      <div class="flex flex-wrap items-center gap-4 pt-2">
        {
          course.data.price != null && (
            <p class="font-display text-[28px] leading-9 font-extrabold tracking-[-0.42px] text-[#0f172a]">
              {formatPrice(course.data.price)}
              {course.data.compareAtPrice != null && (
                <span class="ml-2 text-base font-semibold text-[#64748b] line-through">
                  {formatPrice(course.data.compareAtPrice)}
                </span>
              )}
            </p>
          )
        }
        <a
          href={course.data.enrollUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display inline-flex min-h-12 items-center justify-center rounded-lg bg-[#2563eb] px-6 text-[15px] leading-5 font-bold tracking-[0.26px] text-white no-underline shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-2px_rgba(0,0,0,0.1)] hover:bg-[#1d4ed8]"
        >
          Enroll
        </a>
        <p class="text-sm leading-5 text-[#64748b]">Opens SamCart checkout in a new tab.</p>
      </div>
    </div>
  </section>

  {
    course.data.includes.length > 0 && (
      <section class="bg-white px-6 py-12" aria-labelledby="includes-heading">
        <div class="mx-auto w-full max-w-[860px]">
          <h2
            id="includes-heading"
            class="font-display text-2xl leading-8 font-bold tracking-[-0.4px] text-[#0f172a]"
          >
            What this course includes
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {course.data.includes.map((item) => (
              <li class="rounded-xl bg-[#eff4ff] px-4 py-3 text-sm leading-5 text-[#0f172a]">{item}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="bg-[#f8f9ff] px-6 py-12">
    <div class="mx-auto w-full max-w-[860px]">
      <Prose>
        <Content />
      </Prose>
      <a
        href={course.data.enrollUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-display mt-10 inline-flex min-h-12 items-center justify-center rounded-lg bg-[#2563eb] px-6 text-[15px] leading-5 font-bold tracking-[0.26px] text-white no-underline hover:bg-[#1d4ed8]"
      >
        Enroll
      </a>
    </div>
  </section>

  {
    suggestions.length > 0 && (
      <section class="bg-white px-6 py-14" aria-labelledby="related-heading">
        <div class="mx-auto w-full max-w-[1280px]">
          <h2
            id="related-heading"
            class="font-display text-2xl leading-8 font-bold tracking-[-0.4px] text-[#0f172a]"
          >
            More courses
          </h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-3">
            {suggestions.map((item) => (
              <li class="h-full">
                <a
                  href={`/courses/${item.id}/`}
                  class="group flex h-full flex-col rounded-2xl border border-[#e2e8f0] bg-white p-5 no-underline transition duration-150 hover:-translate-y-0.5 hover:border-[#2563eb] hover:shadow-[0_8px_20px_-6px_rgba(37,99,235,0.28)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2563eb]"
                >
                  <h3 class="font-display text-lg leading-6 font-semibold text-[#0f172a] group-hover:text-[#006194]">
                    {item.data.title}
                  </h3>
                  <p class="mt-2 text-sm leading-5 text-[#64748b]">{item.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
