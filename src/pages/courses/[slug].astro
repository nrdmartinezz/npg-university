---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/ui/Prose.astro';
import Glyph from '../../components/home/Glyph.astro';
import {
  courseDuration,
  formatPrice,
  getPublished,
  hasLifetimeAccess,
  relatedCourses,
  savingsPercent,
  trackById,
  type CourseEntry,
} from '../../lib/courses';

export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await getPublished();
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course, courses },
  }));
};

interface Props {
  course: CourseEntry;
  courses: CourseEntry[];
}

const { course, courses } = Astro.props;
const { Content } = await render(course);
const suggestions = relatedCourses(courses, course);
const trackNames = course.data.tracks.map((id) => trackById(id)?.label).filter(Boolean);
const duration = courseDuration(course.data.includes);
const lifetime = hasLifetimeAccess(course.data.includes);
const savings = savingsPercent(course.data.price, course.data.compareAtPrice);
---

<BaseLayout
  title={course.data.title}
  description={course.data.description}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'On-Demand Courses', href: '/courses/' },
    { name: course.data.title, href: `/courses/${course.id}/` },
  ]}
>
  <section class="bg-[#eff4ff] px-6 py-14 sm:py-16">
    <div class="mx-auto flex w-full max-w-[760px] flex-col gap-10">
      <div class="flex flex-col gap-5">
        <p
          class="font-display text-[11px] leading-[14px] font-bold tracking-[1.1px] text-[#006194] uppercase"
        >
          {trackNames.join(' · ')}
        </p>
        <div class="flex flex-col gap-3">
          <h1
            class="font-display text-[clamp(2rem,4vw,3rem)] leading-[1.25] font-bold tracking-[-0.8px] text-[#0f172a]"
          >
            {course.data.title}
          </h1>
          {
            course.data.subtitle && (
              <p class="text-xl leading-8 text-[#0f172a]">{course.data.subtitle}</p>
            )
          }
          <p class="text-lg leading-8 text-[#64748b]">{course.data.description}</p>
        </div>
        {
          course.data.instructor && (
            <p class="text-sm leading-6 text-[#64748b]">
              Taught by <span class="font-semibold text-[#006194]">{course.data.instructor}</span>
            </p>
          )
        }
        <div class="flex flex-wrap gap-2">
          {
            duration && (
              <span class="font-display rounded-full bg-white px-3 py-1 text-[11px] leading-[14px] font-bold tracking-[0.55px] text-[#006194] uppercase">
                {duration}
              </span>
            )
          }
          {
            lifetime && (
              <span class="font-display rounded-full bg-white px-3 py-1 text-[11px] leading-[14px] font-bold tracking-[0.55px] text-[#006194] uppercase">
                Lifetime access
              </span>
            )
          }
          {
            savings != null && (
              <span class="font-display rounded-full bg-[#2563eb] px-3 py-1 text-[11px] leading-[14px] font-bold tracking-[0.55px] text-white uppercase">
                Save {savings}%
              </span>
            )
          }
        </div>
        <div class="flex flex-col items-start gap-4 pt-2 sm:flex-row sm:items-center">
          {
            course.data.price != null && (
              <p class="flex items-baseline gap-2">
                <span class="font-display text-[32px] leading-10 font-extrabold tracking-[-0.42px] text-[#0f172a]">
                  {formatPrice(course.data.price)}
                </span>
                {course.data.compareAtPrice != null && course.data.compareAtPrice > course.data.price && (
                  <span class="text-base leading-6 font-semibold text-[#64748b] line-through">
                    {formatPrice(course.data.compareAtPrice)}
                  </span>
                )}
              </p>
            )
          }
          <a
            href={course.data.enrollUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-display inline-flex min-h-12 items-center justify-center gap-1.5 rounded-lg bg-[#2563eb] px-6 text-[15px] leading-5 font-bold tracking-[0.15px] text-white no-underline shadow-[0_10px_15px_-3px_rgba(37,99,235,0.35)] hover:bg-[#1d4ed8]"
          >
            Enroll now
            <Glyph src="/images/home/icon-arrow.svg" width={12} height={12} />
            <span class="sr-only"> (opens SamCart)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {
    course.data.includes.length > 0 && (
      <section class="bg-white px-6 py-14" aria-labelledby="includes-heading">
        <div class="mx-auto w-full max-w-[1100px]">
          <h2
            id="includes-heading"
            class="font-display text-[clamp(1.5rem,3vw,2rem)] leading-[1.3] font-bold tracking-[-0.4px] text-[#0f172a]"
          >
            What this course includes
          </h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {course.data.includes.map((item) => (
              <li class="flex items-start gap-3 rounded-xl bg-[#eff4ff] px-4 py-4 text-base leading-7 text-[#0f172a]">
                <Glyph src="/images/home/icon-check.svg" width={15} height={15} class="mt-1.5" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="bg-[#f8f9ff] px-6 py-14">
    <div class="mx-auto w-full max-w-[760px]">
      <Prose class="text-lg leading-8 text-[#334155]">
        <Content />
      </Prose>
      <a
        href={course.data.enrollUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-display mt-10 inline-flex min-h-12 items-center justify-center gap-1.5 rounded-lg bg-[#2563eb] px-6 text-[15px] leading-5 font-bold tracking-[0.15px] text-white no-underline shadow-[0_10px_15px_-3px_rgba(37,99,235,0.35)] hover:bg-[#1d4ed8]"
      >
        Enroll now
        <Glyph src="/images/home/icon-arrow.svg" width={12} height={12} />
        <span class="sr-only"> (opens SamCart)</span>
      </a>
    </div>
  </section>

  {
    suggestions.length > 0 && (
      <section class="bg-white px-6 py-14" aria-labelledby="related-heading">
        <div class="mx-auto w-full max-w-[1100px]">
          <h2
            id="related-heading"
            class="font-display text-[clamp(1.5rem,3vw,2rem)] leading-[1.3] font-bold tracking-[-0.4px] text-[#0f172a]"
          >
            More courses
          </h2>
          <ul class="mt-6 grid gap-5 sm:grid-cols-3">
            {suggestions.map((item) => (
              <li class="h-full">
                <a
                  href={`/courses/${item.id}/`}
                  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-[#e2e8f0] bg-white no-underline transition duration-150 hover:-translate-y-0.5 hover:border-[#2563eb] hover:shadow-[0_8px_20px_-6px_rgba(37,99,235,0.28)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2563eb]"
                >
                  <span class="flex flex-1 flex-col gap-2 p-5">
                    <h3 class="font-display text-lg leading-7 font-semibold text-[#0f172a] group-hover:text-[#006194]">
                      {item.data.title}
                    </h3>
                    {item.data.subtitle && (
                      <p class="text-sm leading-6 text-[#64748b]">{item.data.subtitle}</p>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
