---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cardTitle, coursesInTrack, formatPrice, getPublished, tracks } from '../../lib/courses';

const courses = await getPublished();
const groups = tracks
  .map((track) => ({ ...track, courses: coursesInTrack(courses, track.id) }))
  .filter((group) => group.courses.length > 0);
---

<BaseLayout
  title="On-Demand Courses"
  description="On-demand courses for leadership, the front desk, the new patient experience, treatment coordinators, and the clinical team. Descriptions live here. Enrollment opens on SamCart."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'On-Demand Courses', href: '/courses/' },
  ]}
>
  <section class="bg-[#eff4ff] px-6 py-16">
    <div class="mx-auto flex w-full max-w-[1280px] flex-col gap-6">
      <div class="max-w-3xl">
        <p class="font-display text-[11px] leading-[14px] font-bold tracking-[1.1px] text-[#006194] uppercase">
          Coaching · On-Demand Courses
        </p>
        <h1 class="font-display text-[clamp(2rem,4vw,3rem)] leading-[1.15] font-bold tracking-[-0.8px] text-[#0f172a]">
          On-Demand Courses
        </h1>
        <p class="mt-3 text-lg leading-7 text-[#64748b]">
          The same courses listed under Coaching on New Patient Group, grouped by team. Read the
          description here. Enrollment and payment open on SamCart.
        </p>
      </div>
      <div role="tablist" aria-label="Filter courses by team" class="flex flex-wrap gap-2">
        <button
          type="button"
          role="tab"
          id="filter-all"
          data-course-filter="all"
          aria-selected="true"
          class="font-display inline-flex min-h-11 items-center rounded-full bg-white px-4 text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#006194] shadow-[0_1px_1px_rgba(0,0,0,0.05)] hover:bg-[#dce9ff] aria-selected:bg-[#2563eb] aria-selected:text-white aria-selected:hover:bg-[#1d4ed8]"
        >
          All
        </button>
        {
          groups.map((group) => (
            <button
              type="button"
              role="tab"
              id={`filter-${group.id}`}
              data-course-filter={group.id}
              aria-selected="false"
              aria-controls={group.id}
              class="font-display inline-flex min-h-11 items-center rounded-full bg-white px-4 text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#006194] shadow-[0_1px_1px_rgba(0,0,0,0.05)] hover:bg-[#dce9ff] aria-selected:bg-[#2563eb] aria-selected:text-white aria-selected:hover:bg-[#1d4ed8]"
            >
              {group.label}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <div id="course-results">
  {
    groups.map((group) => (
      <section
        id={group.id}
        data-course-track={group.id}
        class="scroll-mt-28 bg-[#f8f9ff] px-6 py-14"
        aria-labelledby={`${group.id}-heading`}
      >
        <div class="mx-auto flex w-full max-w-[1280px] flex-col gap-6">
          <div class="max-w-3xl">
            <h2
              id={`${group.id}-heading`}
              class="font-display text-[clamp(1.5rem,3vw,2rem)] leading-tight font-bold tracking-[-0.6px] text-[#0f172a]"
            >
              {group.label}
            </h2>
            <p class="mt-2 text-base leading-6 text-[#64748b]">{group.description}</p>
          </div>
          <ul class="grid gap-5 lg:grid-cols-2">
            {group.courses.map((course) => (
              <li class="flex flex-col rounded-2xl bg-white p-6 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-2px_rgba(0,0,0,0.1)]">
                <h3 class="font-display text-xl leading-7 font-semibold tracking-[-0.2px] text-[#0f172a]">
                  <a href={`/courses/${course.id}/`} class="text-inherit no-underline hover:text-[#006194]">
                    {cardTitle(course, group.id)}
                  </a>
                </h3>
                <p class="mt-2 text-base leading-[26px] text-[#64748b]">{course.data.description}</p>
                {course.data.includes.length > 0 && (
                  <ul class="mt-4 flex flex-col gap-1 text-sm leading-5 text-[#0f172a]">
                    {course.data.includes.slice(0, 3).map((item) => (
                      <li class="flex gap-2">
                        <span class="text-[#006194]" aria-hidden="true">
                          ✓
                        </span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <div class="mt-auto flex flex-wrap items-center gap-3 pt-6">
                  {course.data.price != null && (
                    <p class="font-display text-2xl font-extrabold tracking-[-0.3px] text-[#0f172a]">
                      {formatPrice(course.data.price)}
                    </p>
                  )}
                  <a
                    href={`/courses/${course.id}/`}
                    class="font-display inline-flex min-h-11 items-center justify-center rounded-lg bg-[#006194]/10 px-4 text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#006194] no-underline hover:bg-[#006194]/15"
                  >
                    Course details
                  </a>
                  <a
                    href={course.data.enrollUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-display inline-flex min-h-11 items-center justify-center rounded-lg bg-[#2563eb] px-6 text-[13px] leading-[18px] font-bold tracking-[0.26px] text-white no-underline hover:bg-[#1d4ed8]"
                  >
                    Enroll
                    <span class="sr-only"> (opens SamCart)</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-course-filter]');
  const panels = document.querySelectorAll<HTMLElement>('[data-course-track]');
  const ids = new Set([...panels].map((panel) => panel.dataset.courseTrack));

  function show(raw: string) {
    const active = raw && ids.has(raw) ? raw : 'all';
    for (const panel of panels) {
      panel.hidden = active !== 'all' && panel.dataset.courseTrack !== active;
    }
    for (const tab of tabs) {
      tab.setAttribute('aria-selected', String(tab.dataset.courseFilter === active));
    }
  }

  show(location.hash.replace('#', ''));

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const id = tab.dataset.courseFilter ?? 'all';
      const base = `${location.pathname}${location.search}`;
      const url = id === 'all' ? base : `${base}#${id}`;
      const y = window.scrollY;
      history.pushState(null, '', url);
      show(id);
      window.scrollTo(0, y);
    });
  }

  window.addEventListener('hashchange', () => show(location.hash.replace('#', '')));
  window.addEventListener('popstate', () => show(location.hash.replace('#', '')));
</script>
