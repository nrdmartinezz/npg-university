---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import PartnerLogos from '../components/home/PartnerLogos.astro';
import KpiRibbon from '../components/home/KpiRibbon.astro';
import Curriculum from '../components/home/Curriculum.astro';
import CourseCatalog from '../components/home/CourseCatalog.astro';
import PracticeEngine from '../components/home/PracticeEngine.astro';
import Superfans from '../components/home/Superfans.astro';
import Advisor from '../components/home/Advisor.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { getPublished, trackById } from '../lib/courses';

const featured = (await getPublished())
  .filter((course) => course.data.featured)
  .map((course) => ({
    href: `/courses/${course.id}/`,
    enrollUrl: course.data.enrollUrl,
    title: course.data.title,
    description: course.data.description,
    department: course.data.tracks
      .map((id) => trackById(id)?.label)
      .filter(Boolean)
      .join(' · '),
    includes: course.data.includes,
    price: course.data.price,
    image: course.data.image,
    imageAlt: course.data.imageAlt,
  }));
---

<BaseLayout titleExact title="New Patient Group On-Demand Academy">
  <Hero />
  <PartnerLogos />
  <KpiRibbon />
  <Curriculum />
  <CourseCatalog courses={featured} />
  <PracticeEngine />
  <Superfans />
  <Advisor />
  <HomeFaq />
  <FinalCta />
</BaseLayout>
