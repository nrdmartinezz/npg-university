---
interface Crumb {
  name: string;
  href: string;
  label?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="bg-[#0b132b] text-[#f8f9ff]">
  <ol
    class="font-display mx-auto flex w-full max-w-[1280px] items-center overflow-hidden px-6 py-2.5 text-[13px] leading-[18px] whitespace-nowrap"
  >
    {
      items.map((item, index) => {
        const current = index === items.length - 1;
        const text = item.label ?? item.name;
        return (
          <li class:list={['inline-flex items-center', current ? 'min-w-0' : 'shrink-0']}>
            {index > 0 && (
              <span class="px-2 text-[#94a3b8]" aria-hidden="true">
                /
              </span>
            )}
            {current ? (
              <span aria-current="page" class="truncate font-semibold text-white" title={item.name}>
                {text}
              </span>
            ) : (
              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 font-medium text-[#cbdbf5] no-underline hover:text-white"
              >
                {index === 0 && (
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 14 14"
                    fill="none"
                    aria-hidden="true"
                    class="shrink-0"
                  >
                    <path
                      d="M12 7H2M6 3 2 7l4 4"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
                {text}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
