---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Quick Links',
    links: [
      { label: 'On-Demand Courses', href: '/courses/' },
      { label: 'Live Bootcamps', href: '/#advisory' },
      { label: 'Private Diamond & Platinum Coaching', href: '/#advisory' },
      { label: 'Mastermind Events', href: '/#advisory' },
      { label: 'New Patient Group Podcast', href: '/#advisory' },
    ],
  },
  {
    heading: 'Course Categories',
    links: [
      { label: 'Practice Culture & Leadership', href: '/courses/#leadership' },
      { label: 'Receptionist & Hospitality', href: '/courses/#receptionist' },
      { label: 'New Patient Experience', href: '/courses/#new-patient-experience' },
      { label: 'Treatment Coordinator Conversion', href: '/courses/#treatment-coordinator' },
      { label: 'Clinical Team', href: '/courses/#clinical-team' },
    ],
  },
];

const legal = [
  { label: 'Privacy Policy', href: '/privacy/' },
  { label: 'Terms of Service', href: '/terms/' },
  { label: '30-Day Guarantee Terms', href: '/#advisory' },
];
---

<footer class="bg-[#0b132b] pt-10 pb-6 text-[#cbdbf5]">
  <div class="mx-auto w-full max-w-[1280px] px-6">
    <div class="grid gap-10 border-b border-[#1e293b] pb-10 md:grid-cols-2 xl:grid-cols-12">
      <div class="flex flex-col gap-4 xl:col-span-4">
        <a href="/" class="inline-flex w-fit no-underline" aria-label="New Patient Group">
          <img
            src="/images/home/logo.png"
            alt="New Patient Group"
            width="122"
            height="93"
            class="h-[93px] w-auto"
          />
        </a>
        <p class="max-w-sm text-base leading-7">
          The most transformational dental &amp; orthodontic practice growth program in history.
          Founded by Brian Wright.
        </p>
        <p class="flex items-center gap-2 pt-1">
          <span class="text-base leading-6 text-[#2563eb]" aria-hidden="true">®</span>
          <span
            class="font-display rounded-full bg-[#006577]/20 px-2 py-1 text-[11px] leading-[14px] font-bold tracking-[0.66px] text-[#acedff] uppercase"
          >
            HIPAA &amp; Clinical Safe
          </span>
        </p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading} class="xl:col-span-3">
            <h2 class="font-display text-lg leading-8 font-semibold tracking-[-0.45px] text-[#f8f9ff]">
              {column.heading}
            </h2>
            <ul class="mt-4 flex flex-col gap-2">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-10 items-center text-sm leading-6 text-[#cbdbf5] no-underline hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="xl:col-span-2">
        <h2
          class="font-display text-lg leading-8 font-semibold tracking-[-0.45px] text-[#f8f9ff]"
        >
          Contact &amp; HQ
        </h2>
        <p class="mt-4 text-sm leading-7">
          2064 Ever Red Court<br />
          Colorado Springs, CO<br />
          80921
        </p>
        <a
          href="/#advisory"
          class="font-display mt-3 inline-flex text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#cce5ff] underline decoration-1 underline-offset-2"
        >
          Book Private Office Briefing →
        </a>
      </div>
    </div>

    <div
      class="flex flex-col gap-4 pt-6 text-sm leading-6 text-[#bfc7d2] md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} New Patient Group. All rights reserved. Transforming practices worldwide.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legal.map((link) => (
            <li>
              <a href={link.href} class="text-[#bfc7d2] no-underline hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
