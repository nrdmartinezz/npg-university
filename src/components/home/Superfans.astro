---
import Glyph from './Glyph.astro';

const quotes = [
  {
    quote:
      'The ROI isn’t incremental—it’s game-changing. Our same-day starts jumped immediately after rolling out the presentation protocols.',
    emphasis: 'Our same-day starts jumped immediately',
    name: 'Dr. Jamie Reynolds',
    role: 'Reynolds Orthodontics • MI',
  },
  {
    quote:
      'Every team member took immediate ownership. It turned our phones into a conversion machine.',
    emphasis: 'It turned our phones into a conversion machine.',
    name: 'Dr. Drew Ferris',
    role: 'Ferris Orthodontics • CA',
  },
  {
    quote:
      'Tailored specifically to patient psychology. The team morale shift alone paid for this ten times over.',
    emphasis: 'The team morale shift alone paid for this ten times over.',
    name: 'Dr. Regina Blevins',
    role: 'Minnesota Orthodontics • MN',
  },
  {
    quote:
      'Bridges clinical excellence with business innovation. Our staff feels empowered and totally locked into our vision.',
    emphasis: 'Our staff feels empowered and totally locked into our vision.',
    name: 'Dr. Jep Paschal',
    role: 'Paschal Orthodontics • CA',
  },
];
---

<section class="bg-[#f8f9ff] px-6 py-16" aria-labelledby="proof-heading">
  <div class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-6">
    <div class="max-w-3xl text-center">
      <p
        class="font-display text-[11px] leading-[14px] font-bold tracking-[1.1px] text-[#006194] uppercase"
      >
        America’s leading orthodontic superfans
      </p>
      <h2
        id="proof-heading"
        class="font-display mt-3 text-[clamp(1.875rem,4vw,2.5rem)] leading-[1.3] font-bold tracking-[-0.8px] text-[#0f172a]"
      >
        Trusted by the Finest Clinicians in History
      </h2>
      <p class="mt-4 text-base leading-7 text-[#64748b]">
        From orthodontists who opened yesterday to the most legendary clinical leaders in the
        nation, New Patient Group is the gold standard in practice growth.
      </p>
    </div>

    <ul class="grid w-full gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        quotes.map((item) => {
          const [before = item.quote, after = ''] = item.quote.split(item.emphasis);
          return (
            <li class="flex h-full flex-col justify-between rounded-2xl bg-white p-6 shadow-[0_1px_1px_rgba(0,0,0,0.05)]">
              <div>
                <p class="flex gap-1" aria-label="5 out of 5 stars">
                  {Array.from({ length: 5 }).map(() => (
                    <Glyph src="/images/home/icon-star-gold.svg" width={15} height={14.25} />
                  ))}
                </p>
                <blockquote class="mt-4 text-sm leading-7 text-[#0f172a] italic">
                  “{before}
                  <strong class="font-bold italic">{item.emphasis}</strong>
                  {after}”
                </blockquote>
              </div>
              <footer class="mt-6 border-t border-[#e5eeff] pt-5">
                <p>
                  <span class="font-display block text-lg leading-7 font-semibold text-[#0f172a]">
                    {item.name}
                  </span>
                  <span class="mt-0.5 block text-sm leading-6 text-[#64748b]">{item.role}</span>
                </p>
              </footer>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
