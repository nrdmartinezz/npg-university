---
import Glyph from './Glyph.astro';
import FormMessage from '../ui/FormMessage.astro';
import { site } from '../../config/site';

const action = site.formEndpoint || '';
const thankYou = new URL('/thank-you/', site.url).href;

const highlights = [
  {
    title: 'Custom Curriculum Audit',
    body: 'We review your current phone conversion and case presentation workflow to identify revenue leaks.',
    icon: '/images/home/icon-clipboard.svg',
    width: 15,
    height: 15,
    wash: 'bg-[#2563eb]/20',
  },
  {
    title: 'Instant Sample Access',
    body: 'Receive complimentary full-length module previews, script guides, and cheat sheets for your staff to test.',
    icon: '/images/home/icon-sample.svg',
    width: 16.667,
    height: 16.667,
    wash: 'bg-[#acedff]/20',
  },
  {
    title: 'Zero-Pressure Strategy Call',
    body: 'Direct, candid advice from growth specialists who work exclusively with high-performing dental and orthodontic practices.',
    icon: '/images/home/icon-advisor.svg',
    width: 16.667,
    height: 15,
    wash: 'bg-[#2563eb]/20',
  },
];

const focusOptions = [
  'Front Desk & Phone Conversion',
  'Treatment Coordinator & Case Acceptance',
  'Culture & Leadership',
  'Team Hospitality & Patient Experience',
  'Not sure — recommend a starting place',
];

const teamOptions = [
  '1–5 Team Members (Single Location)',
  '6–15 Team Members',
  '16–40 Team Members',
  'Multi-location group',
];

const fieldClass =
  'w-full rounded-lg border border-[#e2e8f0] bg-[#f8fafc] px-4 py-3 text-sm text-[#0b1c30] placeholder:text-[#9ca3af]';
---

<section id="advisory" class="bg-[#eff4ff] px-6 py-16 sm:py-24" aria-labelledby="advisory-heading">
  <div class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-6">
    <div class="max-w-3xl text-center">
      <p
        class="font-display inline-flex items-center gap-1 rounded-full bg-[#006194]/10 px-4 py-1 text-[11px] leading-[14px] font-bold tracking-[0.55px] text-[#006194] uppercase"
      >
        <Glyph src="/images/home/icon-info.svg" width={13.333} height={13.333} />
        Unsure which training is right for your practice?
      </p>
      <h2
        id="advisory-heading"
        class="font-display mt-4 text-[clamp(1.875rem,4vw,2.5rem)] leading-[1.3] font-bold tracking-[-0.8px] text-[#0f172a]"
      >
        Talk With a Practice Growth Advisor
      </h2>
      <p class="mt-4 text-base leading-7 text-[#64748b]">
        Not sure whether a single course, team-wide access, or private coaching fits your practice
        goals? Speak directly with our team or request custom course outlines.
      </p>
    </div>

    <div class="grid w-full items-start gap-6 lg:grid-cols-2">
      <div
        class="relative flex flex-col justify-between gap-6 overflow-hidden rounded-2xl bg-[#0b132b] p-6 text-[#f8f9ff] shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)]"
      >
        <div
          class="pointer-events-none absolute -top-12 -right-12 size-64 rounded-full bg-[#006194]/20 blur-[32px]"
          aria-hidden="true"
        >
        </div>
        <div class="relative flex flex-col gap-5">
          <p class="text-base leading-6 text-[#2563eb]" aria-hidden="true">®</p>
          <h3 class="font-display text-[28px] leading-10 font-bold tracking-[-0.42px]">
            Get a Custom Roadmap Before You Invest
          </h3>
          <p class="text-sm leading-6 text-[#cbdbf5]">
            Every dental and orthodontic practice faces distinct hurdles—from price resistance at
            the front desk to case presentation friction. Our advisors help pinpoint your
            highest-ROI starting place.
          </p>
          <ul class="flex flex-col gap-5 pt-2">
            {
              highlights.map((item) => (
                <li class="flex items-start gap-2">
                  <span
                    class:list={[
                      'mt-0.5 flex size-9 items-center justify-center rounded-xl',
                      item.wash,
                    ]}
                  >
                    <Glyph src={item.icon} width={item.width} height={item.height} />
                  </span>
                  <span>
                    <span class="font-display block text-lg leading-7 font-semibold">
                      {item.title}
                    </span>
                    <span class="mt-1 block text-sm leading-6 text-[#cbdbf5]">{item.body}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <aside
          class="relative rounded-xl border-t border-[#f8f9ff]/10 bg-[#1e293b]/80 px-2 pt-4 pb-2"
        >
          <div class="flex items-start gap-2">
            <span class="mt-0.5 flex size-9 items-center justify-center rounded-xl bg-[#2563eb]/20">
              <Glyph src="/images/home/icon-clipboard.svg" width={15} height={15} />
            </span>
            <p>
              <span
                class="font-display block text-[13px] leading-[18px] font-bold tracking-[0.26px]"
              >
                “Average client adds +41.3% in same-day signed contracts.”
              </span>
              <span
                class="font-display block text-[11px] leading-[14px] font-bold tracking-[0.66px] text-[#cbdbf5]"
              >
                Over 250+ hours of battle-tested training across 1,200+ practices nationwide.
              </span>
            </p>
          </div>
        </aside>
      </div>

      <div
        class="rounded-2xl border border-[#e2e8f0] bg-white p-6 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)]"
      >
        <div class="flex items-center justify-between gap-3">
          <p
            class="font-display rounded bg-[#006194]/10 px-2 py-0.5 text-[11px] leading-[14px] font-bold tracking-[0.55px] text-[#006194] uppercase"
          >
            Personalized advisory
          </p>
          <span class="text-base text-[#2563eb]" aria-hidden="true">®</span>
        </div>
        <h3
          class="font-display mt-3 text-[28px] leading-10 font-bold tracking-[-0.42px] text-[#0f172a]"
        >
          Request Course Info &amp; Custom Recommendation
        </h3>
        <p class="mt-3 text-sm leading-6 text-[#64748b]">
          Tell us about your practice and our clinical training advisors will compile the ideal
          course plan.
        </p>

        <form
          id="advisory-form"
          action={action}
          method="POST"
          class="mt-6 flex flex-col gap-4"
          data-site-form
          data-thank-you={thankYou}
          data-track-source="advisory-form"
        >
          {action && <input type="hidden" name="form_type" value="contact" />}
          <input
            type="hidden"
            name="message"
            value="Please send a custom course recommendation and module previews."
          />
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="_gotcha">Leave this field empty</label>
            <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="flex flex-col gap-2">
              <span
                class="font-display text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#0f172a]"
              >
                Full Name <span class="text-[#ba1a1a]">*</span>
              </span>
              <input
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Dr. Sarah Miller"
                class={fieldClass}
              />
            </label>
            <label class="flex flex-col gap-2">
              <span
                class="font-display text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#0f172a]"
              >
                Practice / Clinic Name <span class="text-[#ba1a1a]">*</span>
              </span>
              <input
                name="practice"
                type="text"
                required
                autocomplete="organization"
                placeholder="Miller Orthodontics"
                class={fieldClass}
              />
            </label>
            <label class="flex flex-col gap-2">
              <span
                class="font-display text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#0f172a]"
              >
                Work Email <span class="text-[#ba1a1a]">*</span>
              </span>
              <input
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="doctor@millerortho.com"
                class={fieldClass}
              />
            </label>
            <label class="flex flex-col gap-2">
              <span
                class="font-display text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#0f172a]"
              >
                Phone Number <span class="text-[#ba1a1a]">*</span>
              </span>
              <input
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="(555) 234-5678"
                class={fieldClass}
              />
            </label>
            <label class="flex flex-col gap-2">
              <span
                class="font-display text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#0f172a]"
              >
                Primary Practice Focus <span class="text-[#ba1a1a]">*</span>
              </span>
              <select name="service" required class={fieldClass}>
                {focusOptions.map((option) => <option value={option}>{option}</option>)}
              </select>
            </label>
            <label class="flex flex-col gap-2">
              <span
                class="font-display text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#0f172a]"
              >
                Team Size / Locations
              </span>
              <select name="hear_about_us" class={fieldClass}>
                {teamOptions.map((option) => <option value={option}>{option}</option>)}
              </select>
            </label>
          </div>

          <FormMessage />

          <div class="flex flex-col gap-2 pt-1">
            <button
              type="submit"
              class="font-display inline-flex min-h-12 w-full items-center justify-center gap-1 rounded-lg bg-[#2563eb] px-4 py-4 text-[15px] leading-5 font-extrabold tracking-[0.15px] text-white shadow-[0_10px_15px_-3px_rgba(0,0,0,0.1),0_4px_6px_-4px_rgba(0,0,0,0.1)] hover:bg-[#1d4ed8]"
            >
              Get Custom Recommendation &amp; Previews
              <Glyph src="/images/home/icon-arrow-form.svg" width={12} height={12} />
            </button>
            <p
              class="font-display inline-flex items-center justify-center gap-1 text-center text-[11px] leading-[14px] font-bold tracking-[0.66px] text-[#64748b]"
            >
              <Glyph src="/images/home/icon-lock-sm.svg" width={9.333} height={12.25} />
              100% confidential. No spam. A practice advisor will follow up within 1 business hour.
            </p>
          </div>
        </form>
      </div>
    </div>

    <aside
      class="flex w-full max-w-4xl flex-col gap-4 rounded-2xl border border-[#e2e8f0] bg-white p-4 shadow-[0_1px_1px_rgba(0,0,0,0.05)] md:flex-row md:items-center md:justify-between"
    >
      <div class="flex items-start gap-4">
        <span
          class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-xl bg-[#2563eb]/20"
        >
          <Glyph src="/images/home/icon-clipboard.svg" width={15} height={15} />
        </span>
        <p>
          <span class="font-display block text-lg leading-7 font-semibold text-[#0f172a]">
            100% Risk-Free 30-Day Production Guarantee
          </span>
          <span class="mt-1 block text-sm leading-6 text-[#64748b]">
            If your team completes the course curriculum and doesn’t see an immediate elevation in
            caller conversions and morale, contact our headquarters for a prompt, courteous full
            refund.
          </span>
        </p>
      </div>
      <p
        class="font-display w-fit shrink-0 rounded-full bg-[#006194]/10 px-4 py-1.5 text-[11px] leading-[14px] font-bold tracking-[0.55px] text-[#006194] uppercase"
      >
        Verified NPG Promise
      </p>
    </aside>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#advisory-form');
  form?.addEventListener(
    'submit',
    () => {
      const message = form.querySelector<HTMLInputElement>('[name="message"]');
      if (!message) return;
      const data = new FormData(form);
      message.value = [
        'Please send a custom course recommendation and module previews.',
        `Practice: ${data.get('practice') ?? ''}`,
        `Focus: ${data.get('service') ?? ''}`,
        `Team size: ${data.get('hear_about_us') ?? ''}`,
      ].join('\n');
    },
    { capture: true },
  );
</script>
