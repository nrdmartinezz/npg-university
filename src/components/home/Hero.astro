---
import Glyph from './Glyph.astro';

const metrics = ['+28.6% Production', '+41.3% Same-Day Starts', '−96% Ad Waste'];
const highlights = [
  { icon: '/images/home/icon-modules.svg', width: 15, height: 15, label: '18 Modules' },
  { icon: '/images/home/icon-script.svg', width: 12, height: 15, label: 'Phone & TC Script Deck' },
  { icon: '/images/home/icon-cert.svg', width: 12, height: 15.75, label: 'Team Certification' },
];
---

<section
  class="relative overflow-hidden bg-gradient-to-b from-[#0b132b] via-[#1e293b] to-[#0b132b] px-6 py-16 text-[#f8f9ff] sm:py-24"
>
  <div
    class="pointer-events-none absolute -top-24 -left-20 size-96 rounded-full bg-[#006194]/20 blur-[32px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute top-1/2 -right-32 size-[32rem] -translate-y-1/2 rounded-full bg-[#2563eb]/15 blur-[32px]"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto grid w-full max-w-[1280px] items-center gap-10 lg:grid-cols-12 lg:gap-10"
  >
    <div class="flex flex-col gap-6 lg:col-span-7">
      <p
        class="font-display w-fit rounded-full bg-[#f8f9ff]/10 px-4 py-1 text-[11px] leading-[14px] font-bold tracking-[0.55px] text-[#acedff] uppercase backdrop-blur-sm"
      >
        New Patient Group On-Demand Academy • 250+ Hours of Proven Practice Training
      </p>

      <h1
        class="font-display text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.25] font-extrabold tracking-[-0.03em]"
      >
        Train Your Team On Demand.
        <span class="text-[#acedff]">Master Consumer Psychology.</span>
      </h1>

      <p class="max-w-2xl text-lg leading-8 text-[#cbdbf5]">
        Battle-tested on-demand courses to train staff instantly, master patient psychology, and
        convert more same-day starts.
      </p>

      <div class="pt-1 pb-2">
        <a
          href="#courses"
          class="font-display inline-flex min-h-12 items-center gap-2 rounded-lg bg-[#2563eb] px-6 py-4 text-[15px] leading-5 font-bold tracking-[0.15px] text-white no-underline shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)] hover:bg-[#1d4ed8]"
        >
          Explore All On-Demand Courses
          <Glyph src="/images/home/icon-chevron-down.svg" width={13.333} height={13.333} />
        </a>
      </div>

      <div
        class="flex flex-col gap-3 rounded-xl bg-[#f8f9ff]/5 p-4 backdrop-blur-sm sm:flex-row sm:items-center sm:justify-between"
      >
        <p
          class="font-display inline-flex items-center gap-1 text-[13px] leading-[18px] font-semibold tracking-[0.26px]"
        >
          <Glyph src="/images/home/icon-trend.svg" width={18.333} height={17.5} />
          Avg. Results:
        </p>
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
          {
            metrics.map((metric, index) => (
              <>
                {index > 0 && (
                  <li
                    class="font-display text-[13px] font-semibold text-[#acedff]/40"
                    aria-hidden="true"
                  >
                    |
                  </li>
                )}
                <li
                  class:list={[
                    'font-display text-[13px] leading-[18px] font-bold tracking-[0.26px]',
                    index === metrics.length - 1 ? 'text-[#cce5ff]' : 'text-[#f8f9ff]',
                  ]}
                >
                  {metric}
                </li>
              </>
            ))
          }
        </ul>
      </div>
    </div>

    <article
      class="flex flex-col rounded-2xl bg-[#1e293b] p-4 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)] lg:col-span-5"
    >
      <div class="relative overflow-hidden rounded-xl bg-[#0b132b]">
        <img
          src="/images/home/hero-faculty.png"
          alt="Brian Wright teaching The Consumer Psychology of Practice Growth"
          width="512"
          height="286"
          class="aspect-[458/286] w-full object-cover opacity-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#0b132b] via-[#0b132b]/40 to-transparent"
        >
        </div>
        <p
          class="font-display absolute top-3 right-3 inline-flex items-center gap-1 rounded-full bg-[#0b132b]/80 px-2 py-1 text-[11px] leading-[14px] font-bold tracking-[0.66px] text-[#f8f9ff] backdrop-blur-sm"
        >
          <Glyph src="/images/home/icon-star.svg" width={11.667} height={11.083} />
          4.9 (512 reviews)
        </p>
        <a
          href="#advisory"
          class="absolute inset-0 flex items-center justify-center"
          aria-label="Preview The Consumer Psychology of Practice Growth"
        >
          <span
            class="flex size-16 items-center justify-center rounded-full bg-[#2563eb] pr-3.5 pl-[18px] shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)]"
          >
            <Glyph src="/images/home/icon-play.svg" width={14.667} height={18.667} />
          </span>
        </a>
        <div class="absolute inset-x-3 bottom-3">
          <p
            class="font-display text-[11px] leading-[14px] font-semibold tracking-[0.66px] text-[#acedff] uppercase"
          >
            Taught by Brian Wright • Founder &amp; CEO
          </p>
          <h2 class="font-display mt-1 text-lg leading-7 font-semibold">
            The Consumer Psychology of Practice Growth
          </h2>
        </div>
      </div>

      <div class="flex flex-col gap-2 pt-4">
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {
            highlights.map((item) => (
              <li class="font-display inline-flex items-center gap-1.5 text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#cbdbf5]">
                <Glyph src={item.icon} width={item.width} height={item.height} />
                {item.label}
              </li>
            ))
          }
        </ul>
        <a
          href="#advisory"
          class="font-display inline-flex min-h-11 items-center justify-center gap-1 rounded-lg bg-[#2563eb] px-4 py-2 text-[15px] leading-5 font-semibold tracking-[0.15px] text-white no-underline hover:bg-[#1d4ed8]"
        >
          Enroll Practice Today
          <Glyph src="/images/home/icon-arrow.svg" width={12} height={12} />
        </a>
      </div>
    </article>
  </div>
</section>
