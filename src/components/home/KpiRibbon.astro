---
import Glyph from './Glyph.astro';

const kpis = [
  {
    value: '28.6%',
    label: 'Increase in Total Practice Production',
    color: '#006194',
    wash: 'bg-[#006194]/10',
    icon: '/images/home/icon-kpi-chart.svg',
    width: 20,
    height: 12,
  },
  {
    value: '41.3%',
    label: 'Increase in Same-Day Signed Contracts',
    color: '#006194',
    wash: 'bg-[#006194]/10',
    icon: '/images/home/icon-kpi-handshake.svg',
    width: 22.01,
    height: 20,
  },
  {
    value: '31.0%',
    label: 'Increase in Clear Aligner Starts',
    color: '#006577',
    wash: 'bg-[#006577]/10',
    icon: '/images/home/icon-kpi-aligner.svg',
    width: 20,
    height: 20,
  },
  {
    value: '96.0%',
    label: 'Decrease in Outside Ad Dependency',
    color: '#2563eb',
    wash: 'bg-[#2563eb]/10',
    icon: '/images/home/icon-kpi-savings.svg',
    width: 20,
    height: 19,
  },
];
---

<section class="bg-[#eff4ff] px-6 py-16" aria-labelledby="kpi-heading">
  <div class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-9">
    <div class="max-w-3xl text-center">
      <p
        class="font-display text-[11px] leading-[14px] font-bold tracking-[1.1px] text-[#006194] uppercase"
      >
        Growth numbers most only dream about
      </p>
      <h2
        id="kpi-heading"
        class="font-display mt-2 text-[clamp(1.5rem,3vw,1.75rem)] leading-9 font-bold tracking-[-0.42px] text-[#0f172a]"
      >
        In the Last 12 Months, Our Clients Have Averaged:
      </h2>
    </div>

    <ul class="grid w-full gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        kpis.map((kpi) => (
          <li class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-2px_rgba(0,0,0,0.1)]">
            <span class="absolute inset-x-0 top-0 h-1.5" style={`background:${kpi.color}`} />
            <div class="flex items-center justify-between gap-3">
              <p class="font-display text-[32px] leading-8 font-bold" style={`color:${kpi.color}`}>
                {kpi.value}
              </p>
              <span
                class:list={['flex size-10 items-center justify-center rounded-full', kpi.wash]}
              >
                <Glyph src={kpi.icon} width={kpi.width} height={kpi.height} />
              </span>
            </div>
            <p class="font-display mt-5 text-lg leading-7 font-semibold text-[#0f172a]">
              {kpi.label}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
