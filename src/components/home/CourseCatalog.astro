---
import Glyph from './Glyph.astro';
import { formatPrice } from '../../lib/courses';

export interface CatalogCourse {
  href: string;
  enrollUrl: string;
  title: string;
  description: string;
  department: string;
  includes: string[];
  price?: number;
  image?: string;
  imageAlt?: string;
}

interface Props {
  courses: CatalogCourse[];
}

const { courses } = Astro.props;
---

<section id="courses" class="bg-[#eff4ff] px-6 py-16" aria-labelledby="courses-heading">
  <div class="mx-auto flex w-full max-w-[1280px] flex-col gap-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p
          class="font-display text-[11px] leading-[14px] font-bold tracking-[1.1px] text-[#006194] uppercase"
        >
          Self-paced training for every department
        </p>
        <h2
          id="courses-heading"
          class="font-display mt-3 text-[clamp(1.875rem,4vw,2.5rem)] leading-[1.3] font-bold tracking-[-0.8px] text-[#0f172a]"
        >
          On-Demand Courses
        </h2>
      </div>
      <a
        href="/courses/"
        class="font-display inline-flex min-h-11 items-center text-[13px] leading-[18px] font-bold tracking-[0.26px] text-[#006194] no-underline hover:underline"
      >
        View all courses
      </a>
    </div>

    <ul class="grid gap-6 lg:grid-cols-2">
      {
        courses.map((course) => (
          <li class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-2px_rgba(0,0,0,0.1)]">
            {course.image && (
              <div class="relative bg-[#0b132b]">
                <img
                  src={course.image}
                  alt={course.imageAlt ?? ''}
                  width="512"
                  height="279"
                  class="aspect-video w-full object-cover object-[center_18%]"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0b132b]/90 via-[#0b132b]/20 to-transparent" />
                <div class="absolute inset-x-4 bottom-3">
                  <p class="font-display text-[11px] leading-[14px] font-semibold tracking-[0.55px] text-[#acedff] uppercase">
                    {course.department}
                  </p>
                  <h3 class="font-display mt-1 text-[22px] leading-9 font-semibold tracking-[-0.22px] text-[#f8f9ff]">
                    <a href={course.href} class="text-inherit no-underline hover:underline">
                      {course.title}
                    </a>
                  </h3>
                </div>
              </div>
            )}

            <div class="flex flex-1 flex-col gap-5 p-6">
              {!course.image && (
                <div>
                  <p class="font-display text-[11px] leading-[14px] font-semibold tracking-[0.55px] text-[#006194] uppercase">
                    {course.department}
                  </p>
                  <h3 class="font-display mt-2 text-[22px] leading-9 font-semibold tracking-[-0.22px] text-[#0f172a]">
                    <a href={course.href} class="text-inherit no-underline hover:underline">
                      {course.title}
                    </a>
                  </h3>
                </div>
              )}
              <p class="text-base leading-7 text-[#64748b]">{course.description}</p>
              {course.includes.length > 0 && (
                <div class="rounded-xl bg-[#eff4ff] p-5">
                  <p class="font-display text-[11px] leading-[14px] font-bold tracking-[0.55px] text-[#006194] uppercase">
                    What your practice receives
                  </p>
                  <ul class="mt-3 flex flex-col gap-3">
                    {course.includes.slice(0, 4).map((item) => (
                      <li class="flex items-start gap-2 text-sm leading-6 text-[#0f172a]">
                        <span class="mt-1.5">
                          <Glyph
                            src="/images/home/icon-check-course.svg"
                            width={12.225}
                            height={9.019}
                          />
                        </span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <div class="flex flex-col gap-4 px-6 pb-6 sm:flex-row sm:items-end sm:justify-between">
              <div>
                {course.price != null ? (
                  <>
                    <p class="font-display text-[11px] leading-[14px] font-bold tracking-[0.66px] text-[#64748b] uppercase">
                      Listed price
                    </p>
                    <p class="font-display text-[28px] leading-9 font-extrabold tracking-[-0.42px] text-[#0f172a]">
                      {formatPrice(course.price)}
                    </p>
                  </>
                ) : (
                  <p class="text-sm leading-5 text-[#64748b]">Checkout price is on SamCart.</p>
                )}
              </div>
              <div class="flex flex-wrap gap-1">
                <a
                  href={course.href}
                  class="font-display inline-flex min-h-11 items-center justify-center rounded-lg bg-[#006194]/10 px-4 py-2 text-[13px] leading-[18px] font-semibold tracking-[0.26px] text-[#006194] no-underline hover:bg-[#006194]/15"
                >
                  Course details
                </a>
                <a
                  href={course.enrollUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-display inline-flex min-h-11 items-center justify-center rounded-lg bg-[#2563eb] px-6 py-2 text-[13px] leading-[18px] font-bold tracking-[0.26px] text-white no-underline shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-2px_rgba(0,0,0,0.1)] hover:bg-[#1d4ed8]"
                >
                  Enroll
                  <span class="sr-only"> (opens SamCart)</span>
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
